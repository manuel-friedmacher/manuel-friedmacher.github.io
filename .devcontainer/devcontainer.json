{
  "name": "GitHub page",
  "image": "mcr.microsoft.com/devcontainers/ruby:latest", // Uncomment this line to use Python as the base image for the dev container.
  "initializeCommand": "sh .devcontainer/initialize.sh",
  "postCreateCommand": "sh .devcontainer/post-create.sh",
  "runArgs": [
    "--network=host",
    "--env-file",
    ".devcontainer/devcontainer.env"
  ],
  "features": {
    "ghcr.io/devcontainers/features/ruby": "latest",
    "ghcr.io/devcontainers/features/git": "latest"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "shopify.ruby-lsp"
      ],
      "settings": {
        "[ruby]": {
          "editor.defaultFormatter": "Shopify.ruby-lsp",
          "editor.formatOnSave": true
        }
      }
    }
  },
  "mounts": [],
  "remoteUser": "vscode",
  "remoteEnv": {}
}
