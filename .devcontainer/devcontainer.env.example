# Copy this file to devcontainer.env and fill in your credentials.
# devcontainer.env is excluded from git via .gitignore — never commit real credentials.

BTP_USERNAME=*user name*
BTP_PASSWORD=*password*
SCI_USERNAME=*user name*
SCI_PASSWORD=*password*
SCI_CLIENT_ID=*oAuth Client ID*
SCI_CLIENT_SECRET=*oAuth Client Secret*
AWS_ACCESS_KEY_ID=*access_key_id from service key*
AWS_SECRET_ACCESS_KEY=*secret_access_key from service key*